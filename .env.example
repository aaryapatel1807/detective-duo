# Copy to .env.local and fill in what you use. Never commit real keys.

# Realtime provider: "socketio" (default) or "supabase"
NEXT_PUBLIC_REALTIME_PROVIDER=socketio

# URL of the standalone socket.io server (npm run socket). Defaults to http://localhost:4001
NEXT_PUBLIC_SOCKET_URL=http://localhost:4001

# Supabase (only needed when NEXT_PUBLIC_REALTIME_PROVIDER=supabase)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional Gemini enhancement for content banks (graceful fallback to banks when unset)
GEMINI_API_KEY=
